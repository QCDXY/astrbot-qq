# =============================================================================
# AstrBot + NapCat QQ 机器人 环境变量示例
# 复制为 .env 后修改：  PowerShell: Copy-Item .env.example .env
#                       Linux:      cp .env.example .env
# 或直接运行 scripts/init-env.ps1 / scripts/init-env.sh 自动生成随机令牌。
# .env 已被 .gitignore 排除，切勿提交。
# =============================================================================

# ---- 镜像版本（已固定为验证过的版本；升级前请阅读 docs/configuration.md）----
ASTRBOT_IMAGE=soulter/astrbot:v4.29.1
NAPCAT_IMAGE=mlikiowa/napcat-docker:v4.18.41

# ---- 时区 ----
TZ=Asia/Shanghai

# ---- OneBot v11 反向 WebSocket 访问令牌（必填）----
# NapCat 与 AstrBot 两端必须一致。init 服务会把它写入两端配置。
# 生成随机值：PowerShell  -join ((48..57)+(97..122) | Get-Random -Count 32 | % {[char]$_})
#             Linux       openssl rand -hex 24
ONEBOT_ACCESS_TOKEN=change-me-to-a-long-random-string

# ---- 管理界面（默认只绑定 127.0.0.1）----
ASTRBOT_WEBUI_PORT=6185
NAPCAT_WEBUI_PORT=6099
# 宿主机绑定地址。保持 127.0.0.1；如需局域网访问请改用 SSH 隧道或反向代理+鉴权。
WEBUI_BIND_HOST=127.0.0.1
# NapCat WebUI 登录令牌（首次启动时写入，之后在 NapCat WebUI 中修改）
NAPCAT_WEBUI_TOKEN=change-me-napcat-webui-token
# AstrBot WebUI 初始密码（可选；至少 8 位，且含大写字母、小写字母和数字）。留空则首次启动随机生成并打印在日志中。
# 首次登录后系统会要求修改密码。
ASTRBOT_DASHBOARD_INITIAL_PASSWORD=

# ---- 机器人 QQ 号（可选）----
# 填写后 NapCat 会尝试快速登录该账号；留空则每次需要在 WebUI 扫码。
QQ_ACCOUNT=

# ---- 管理员 QQ 号（可选，逗号分隔）----
# 管理员可使用 /provider 等管理指令，且不受 qq_guard 插件的群白名单/限流约束。
ADMIN_QQ=

# ---- 大语言模型（OpenAI 兼容接口）----
# 仅在 AstrBot 首次初始化时写入模型配置；之后请在 AstrBot WebUI 中管理模型。
# API Key 不会写入配置文件：配置中保存的是 "$LLM_API_KEY" 引用，运行时从环境变量读取。
LLM_API_KEY=
# 例：https://api.openai.com/v1 、https://api.deepseek.com/v1 、其他兼容服务的 /v1 地址
LLM_BASE_URL=https://api.openai.com/v1
# 例：gpt-4o-mini 、deepseek-chat
LLM_MODEL=gpt-4o-mini

# ---- NapCat 容器内运行用户（Linux 宿主机可设为 $(id -u) / $(id -g)）----
NAPCAT_UID=1000
NAPCAT_GID=1000
